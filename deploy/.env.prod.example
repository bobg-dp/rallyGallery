COMPOSE_PROJECT_NAME=rallygallery

# Haslo bez znakow @ : / # ? $ — trafia do DATABASE_URL.
POSTGRES_USER=rally
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rally

# openssl rand -base64 32
AUTH_SECRET=change-me
# Dokladny publiczny adres galerii, razem z https://
AUTH_URL=https://galeria.example.pl

# Tylko localhost VPS. 18080 i 18081 sa zajete przez devilSpy.
WEB_BIND_PORT=18082

# Jednorazowo: ./deploy/deploy.sh seed
ADMIN_EMAIL=admin@example.pl
ADMIN_PASSWORD=change-me-min-8
EDITOR_EMAIL=edytor@example.pl
EDITOR_PASSWORD=change-me-min-8
SEED_DEMO=0

# Koszyk R2. Bez tych wartosci aplikacja pisze do ./storage w kontenerze.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rally-gallery
# Publiczny adres koszyka, bez ukosnika na koncu. Przegladarka bierze WebP stamtad.
R2_PUBLIC_BASE_URL=
